{
  "name": "apni-pathshala-firebase",
  "version": "1.0.0",
  "private": true,
  "description": "Firestore security rules + rules tests for AI Pathshala Apps (teacher accounts + Live Class Quiz). Not part of the website.",
  "license": "MIT",
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/rules.test.js",
    "test:emulator": "firebase emulators:exec --project demo-apni-pathshala --only firestore \"npm test\"",
    "emulators": "firebase emulators:start --project demo-apni-pathshala --only firestore,auth",
    "deploy:rules": "firebase deploy --project live --only firestore:rules",
    "deploy:indexes": "firebase deploy --project live --only firestore:indexes"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.32.1"
  },
  "engines": {
    "node": ">=20"
  }
}
